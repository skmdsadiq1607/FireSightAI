# FireSight AI Environment Configuration

# Server Ports & Settings
PORT=5000
NODE_ENV=development
DATA_MODE=demo  # 'demo' or 'live'
FIRMS_REGION=india # Geographic focus: 'india' or custom bbox: minLon,minLat,maxLon,maxLat

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017/firesight_ai

# NASA FIRMS API (Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY_HERE
FIRMS_POLL_INTERVAL_MINUTES=15

# Copernicus Data Space Ecosystem (Sentinel-2 L2A)
# Free registration at https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID_HERE
COPERNICUS_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET_HERE

# Python ML & Analytics Service
PYTHON_AI_URL=http://localhost:8000

# Security & CORS
JWT_SECRET=firesight_ai_super_secret_sih2026_key
CORS_ORIGIN=http://localhost:5173

# Groq Cloud LPU API (Free key from https://console.groq.com/keys)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
